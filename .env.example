# UPSC Studio — Environment Variables
# Copy this file to .env and fill in values as needed.

# YouTube Data API (optional — only for automated publishing)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Anthropic / OpenAI keys (optional — only if using LLM-assisted research)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Google Gemini API key (optional — for AI-assisted research/TTS)
# GOOGLE_API_KEY=
